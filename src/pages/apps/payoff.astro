---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Mortgage payoff calculator"
  description="See how extra monthly payments change your payoff date and total interest."
>
  <section class="pc">
    <header class="pc-head">
      <p class="eyebrow">Tool</p>
      <h1>Mortgage payoff calculator</h1>
      <p class="lede">See how an extra payment each month moves your payoff date and how much interest it saves.</p>
    </header>

    <div class="pc-layout">
      <form class="pc-card pc-form" id="pc-form" novalidate>
        <h2 class="pc-card-title">Your loan</h2>

        <div class="pc-field">
          <label for="bal">Remaining balance</label>
          <div class="pc-input"><span class="pc-affix">$</span><input id="bal" type="number" inputmode="decimal" min="0" step="1000" value="250000" /></div>
        </div>

        <div class="pc-field">
          <label for="rate">Interest rate</label>
          <div class="pc-input"><input id="rate" type="number" inputmode="decimal" min="0" step="0.125" value="6.5" /><span class="pc-affix">%</span></div>
        </div>

        <div class="pc-field">
          <label for="pmt">Monthly payment <span class="pc-hint">principal + interest</span></label>
          <div class="pc-input"><span class="pc-affix">$</span><input id="pmt" type="number" inputmode="decimal" min="0" step="50" value="1800" /></div>
        </div>

        <div class="pc-field">
          <label for="extra">Extra each month</label>
          <div class="pc-input"><span class="pc-affix">$</span><input id="extra" type="number" inputmode="decimal" min="0" step="50" value="200" /></div>
          <input id="extra-range" class="pc-range" type="range" min="0" max="2000" step="25" value="200" aria-label="Extra each month slider" />
        </div>

        <p class="pc-error" id="pc-error" role="alert" hidden></p>
      </form>

      <div class="pc-results" aria-live="polite">
        <div class="pc-stats">
          <div class="pc-stat pc-stat-hero">
            <span class="pc-stat-label">Paid off</span>
            <span class="pc-stat-value" id="s-date">–</span>
            <span class="pc-stat-sub" id="s-date-sub"></span>
          </div>
          <div class="pc-stat">
            <span class="pc-stat-label">Time saved</span>
            <span class="pc-stat-value" id="s-time">–</span>
          </div>
          <div class="pc-stat">
            <span class="pc-stat-label">Interest saved</span>
            <span class="pc-stat-value" id="s-int">–</span>
          </div>
          <div class="pc-stat">
            <span class="pc-stat-label">Total interest</span>
            <span class="pc-stat-value" id="s-total">–</span>
            <span class="pc-stat-sub" id="s-total-sub"></span>
          </div>
        </div>

        <div class="pc-card pc-chart-card">
          <div class="pc-chart-head">
            <h2 class="pc-card-title">Balance over time</h2>
            <ul class="pc-legend" aria-label="Legend">
              <li><span class="pc-swatch pc-swatch-extra"></span>With extra</li>
              <li><span class="pc-swatch pc-swatch-base"></span>No extra</li>
            </ul>
          </div>
          <div class="pc-chart" id="pc-chart">
            <div class="pc-tip" id="pc-tip" hidden></div>
          </div>
        </div>
      </div>
    </div>

    <details class="pc-card pc-table-card">
      <summary>Year-by-year breakdown <span class="pc-hint">with extra payments</span></summary>
      <div class="pc-table-wrap">
        <table class="pc-table">
          <thead>
            <tr><th scope="col">Year</th><th scope="col">Principal</th><th scope="col">Interest</th><th scope="col">Balance</th></tr>
          </thead>
          <tbody id="pc-tbody"></tbody>
        </table>
      </div>
    </details>

    <p class="pc-note">Estimates only. Assumes a fixed rate, monthly compounding, and payments starting next month. Taxes and insurance aren't included.</p>
  </section>
</Base>

<style is:global>
  .pc { padding: clamp(40px, 6vw, 72px) 0 var(--section); }
  .pc-head { max-width: 40em; display: flex; flex-direction: column; gap: 12px; padding-bottom: 36px; }
  .pc-head h1 { margin: 0; font-size: clamp(34px, 5vw, 48px); line-height: 1.08; letter-spacing: -0.03em; font-weight: 600; }

  .pc-layout { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 24px; align-items: start; }
  @media (max-width: 860px) { .pc-layout { grid-template-columns: minmax(0, 1fr); } }

  .pc-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .pc-card-title { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: 0; }

  .pc-form { display: flex; flex-direction: column; gap: 20px; }
  .pc-field { display: flex; flex-direction: column; gap: 8px; }
  .pc-field label { font-size: 14px; font-weight: 500; color: var(--ink-2); }
  .pc-hint { font-weight: 400; color: var(--faint); font-size: 13px; margin-left: 4px; }
  .pc-input {
    display: flex; align-items: center; height: 48px; padding: 0 14px;
    border: 1px solid var(--line-strong); border-radius: 10px; background: var(--bg);
    transition: border-color .15s, box-shadow .15s;
  }
  .pc-input:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(36, 71, 214, .15); background: var(--surface); }
  .pc-input input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
    font: 500 17px/1 var(--mono); color: var(--ink); padding: 0 4px;
  }
  .pc-input input::-webkit-inner-spin-button, .pc-input input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .pc-input input[type=number] { -moz-appearance: textfield; }
  .pc-affix { font-family: var(--mono); color: var(--faint); font-size: 15px; }
  .pc-range { width: 100%; accent-color: var(--accent); height: 28px; margin: 0; }
  .pc-error { margin: 0; font-size: 14px; color: #9a3412; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; padding: 10px 12px; }

  .pc-results { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .pc-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 12px; }
  .pc-stat { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
  .pc-stat-hero { background: var(--dark); border-color: var(--dark); color: var(--bg); }
  .pc-stat-label { font-size: 13px; color: var(--faint); }
  .pc-stat-hero .pc-stat-label, .pc-stat-hero .pc-stat-sub { color: #b9bdc7; }
  .pc-stat-value { font-size: 22px; white-space: nowrap; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .pc-stat-sub { font-size: 13px; color: var(--faint); }

  .pc-chart-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; }
  .pc-legend { list-style: none; margin: 0; padding: 0; display: flex; gap: 16px; font-size: 13px; color: var(--muted); }
  .pc-legend li { display: flex; align-items: center; gap: 8px; }
  .pc-swatch { width: 18px; height: 0; border-top: 2px solid; }
  .pc-swatch-extra { border-color: var(--accent); }
  .pc-swatch-base { border-color: #8a90a0; border-top-style: dashed; }
  .pc-chart { position: relative; height: 300px; }
  .pc-chart svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .pc-chart .grid line { stroke: var(--line); }
  .pc-chart .axis text { fill: var(--faint); font: 12px var(--mono); }
  .pc-chart .line-extra { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
  .pc-chart .area-extra { fill: var(--accent); opacity: .06; }
  .pc-chart .line-base { fill: none; stroke: #8a90a0; stroke-width: 2; stroke-dasharray: 5 4; }
  .pc-chart .xhair { stroke: var(--ink); stroke-width: 1; opacity: .25; }
  .pc-chart .dot { stroke: var(--surface); stroke-width: 2; }
  .pc-chart .end-label { font: 500 12px var(--sans); fill: var(--ink-2); paint-order: stroke; stroke: var(--surface); stroke-width: 4px; stroke-linejoin: round; }
  .pc-tip {
    position: absolute; top: 0; pointer-events: none; z-index: 2; min-width: 170px;
    background: var(--dark); color: #e8e9ec; border-radius: 10px; padding: 10px 12px;
    font-size: 13px; line-height: 1.5; box-shadow: 0 8px 24px -8px rgba(0,0,0,.4);
  }
  .pc-tip b { display: block; font-weight: 600; color: #fff; margin-bottom: 4px; }
  .pc-tip .row { display: flex; justify-content: space-between; gap: 16px; font-variant-numeric: tabular-nums; }
  .pc-tip .k { display: inline-flex; align-items: center; gap: 6px; color: #b9bdc7; }
  .pc-tip .k::before { content: ''; width: 10px; border-top: 2px solid var(--c); }

  .pc-table-card { margin-top: 24px; padding: 0; }
  .pc-table-card summary { cursor: pointer; padding: 20px 24px; font-weight: 600; font-size: 15px; min-height: 44px; }
  .pc-table-wrap { overflow-x: auto; padding: 0 24px 16px; }
  .pc-table { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  .pc-table th { text-align: right; font-weight: 500; color: var(--faint); font-size: 13px; padding: 8px 12px; border-bottom: 1px solid var(--line); }
  .pc-table td { text-align: right; padding: 8px 12px; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 13px; }
  .pc-table th:first-child, .pc-table td:first-child { text-align: left; }
  .pc-note { margin: 20px 0 0; font-size: 13px; color: var(--faint); }
</style>

<script>
  type Run = { months: number; interest: number; balances: number[]; rows: { p: number; i: number; b: number }[] };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const usdK = (n: number) => (n >= 1e6 ? `$${(n / 1e6).toFixed(1)}M` : n >= 1000 ? `$${Math.round(n / 1000)}k` : `$${Math.round(n)}`);
  const span = (m: number) => {
    const y = Math.floor(m / 12), mo = m % 12;
    return [y && `${y} yr${y > 1 ? 's' : ''}`, mo && `${mo} mo`].filter(Boolean).join(' ') || '0 mo';
  };
  const dateAfter = (m: number) => {
    const d = new Date();
    d.setDate(1);
    d.setMonth(d.getMonth() + m);
    return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  };

  function amortize(balance: number, ratePct: number, payment: number): Run | null {
    const r = ratePct / 1200;
    let b = balance, interest = 0, m = 0;
    const balances = [b], rows: Run['rows'] = [];
    if (payment <= b * r) return null;
    while (b > 0.005 && m < 1200) {
      const i = b * r;
      const p = Math.min(payment - i, b);
      b -= p; interest += i; m++;
      balances.push(Math.max(b, 0));
      rows.push({ p, i, b: Math.max(b, 0) });
    }
    return { months: m, interest, balances, rows };
  }

  const ns = 'http://www.w3.org/2000/svg';
  const el = (tag: string, attrs: Record<string, string | number>, parent?: Element) => {
    const e = document.createElementNS(ns, tag);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    parent?.appendChild(e);
    return e;
  };

  let current: { base: Run; extra: Run } | null = null;

  function drawChart() {
    const host = $('pc-chart'), tip = $('pc-tip');
    host.querySelector('svg')?.remove();
    if (!current) return;
    const { base, extra } = current;
    const W = host.clientWidth, H = host.clientHeight;
    const m = { t: 12, r: W < 520 ? 60 : 72, b: 28, l: 52 };
    const iw = W - m.l - m.r, ih = H - m.t - m.b;
    const maxM = base.months;
    const rawStep = base.balances[0] / 4;
    const mag = 10 ** Math.floor(Math.log10(rawStep));
    const tickStep = [1, 2, 2.5, 5, 10].map((f) => f * mag).find((s) => s >= rawStep)!;
    const ticks = Math.ceil(base.balances[0] / tickStep);
    const maxB = ticks * tickStep;
    const x = (i: number) => m.l + (i / maxM) * iw;
    const y = (v: number) => m.t + ih - (v / maxB) * ih;

    const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': 'Loan balance over time, with and without extra payments. Full numbers are in the year-by-year table.' });
    host.prepend(svg);

    const grid = el('g', { class: 'grid' }, svg), axis = el('g', { class: 'axis' }, svg);
    for (let k = 0; k <= ticks; k++) {
      const v = tickStep * k;
      el('line', { x1: m.l, x2: m.l + iw, y1: y(v), y2: y(v) }, grid);
      el('text', { x: m.l - 10, y: y(v) + 4, 'text-anchor': 'end' }, axis).textContent = usdK(v);
    }
    const years = Math.ceil(maxM / 12);
    const step = years > 20 ? 5 : years > 8 ? 2 : 1;
    for (let yr = 0; yr <= years; yr += step) {
      const mm = Math.min(yr * 12, maxM);
      el('text', { x: x(mm), y: m.t + ih + 20, 'text-anchor': 'middle' }, axis).textContent = yr === 0 ? 'Now' : `${yr}y`;
    }

    const path = (bs: number[]) => bs.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');
    el('path', { class: 'area-extra', d: `${path(extra.balances)}L${x(extra.months)},${y(0)}L${x(0)},${y(0)}Z` }, svg);
    el('path', { class: 'line-base', d: path(base.balances) }, svg);
    el('path', { class: 'line-extra', d: path(extra.balances) }, svg);

    el('circle', { class: 'dot', r: 4, cx: x(base.months), cy: y(0), fill: '#8a90a0' }, svg);
    el('circle', { class: 'dot', r: 4, cx: x(extra.months), cy: y(0), fill: 'var(--accent)' }, svg);
    el('text', { class: 'end-label', x: x(extra.months) - 8, y: y(0) - 10, 'text-anchor': 'end' }, svg).textContent = dateAfter(extra.months);
    el('text', { class: 'end-label', x: x(base.months) + 8, y: y(0) + 4 }, svg).textContent = dateAfter(base.months);

    const xh = el('line', { class: 'xhair', y1: m.t, y2: m.t + ih, visibility: 'hidden' }, svg);
    const dB = el('circle', { class: 'dot', r: 5, fill: '#8a90a0', visibility: 'hidden' }, svg);
    const dE = el('circle', { class: 'dot', r: 5, fill: 'var(--accent)', visibility: 'hidden' }, svg);
    const hit = el('rect', { x: m.l, y: m.t, width: iw, height: ih, fill: 'transparent' }, svg);

    const show = (clientX: number) => {
      const r = svg.getBoundingClientRect();
      const i = Math.max(0, Math.min(maxM, Math.round(((clientX - r.left - m.l) / iw) * maxM)));
      const be = extra.balances[Math.min(i, extra.months)] ?? 0, bb = base.balances[i];
      xh.setAttribute('x1', String(x(i))); xh.setAttribute('x2', String(x(i)));
      dB.setAttribute('cx', String(x(i))); dB.setAttribute('cy', String(y(bb)));
      dE.setAttribute('cx', String(x(i))); dE.setAttribute('cy', String(y(be)));
      [xh, dB, dE].forEach((n) => n.setAttribute('visibility', 'visible'));
      tip.innerHTML = `<b>${dateAfter(i)}</b>
        <div class="row"><span class="k" style="--c:var(--accent)">With extra</span><span>${usd.format(be)}</span></div>
        <div class="row"><span class="k" style="--c:#8a90a0">No extra</span><span>${usd.format(bb)}</span></div>`;
      tip.hidden = false;
      const left = x(i) + 14 + tip.offsetWidth > W ? x(i) - 14 - tip.offsetWidth : x(i) + 14;
      tip.style.left = `${left}px`;
      tip.style.top = `${m.t}px`;
    };
    const hide = () => { [xh, dB, dE].forEach((n) => n.setAttribute('visibility', 'hidden')); tip.hidden = true; };
    hit.addEventListener('pointermove', (e) => show((e as PointerEvent).clientX));
    hit.addEventListener('pointerdown', (e) => show((e as PointerEvent).clientX));
    hit.addEventListener('pointerleave', hide);
  }

  function renderTable(run: Run) {
    const body = $('pc-tbody');
    body.innerHTML = '';
    for (let yr = 0; yr * 12 < run.rows.length; yr++) {
      const chunk = run.rows.slice(yr * 12, yr * 12 + 12);
      const p = chunk.reduce((s, r) => s + r.p, 0), i = chunk.reduce((s, r) => s + r.i, 0);
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${yr + 1}</td><td>${usd.format(p)}</td><td>${usd.format(i)}</td><td>${usd.format(chunk[chunk.length - 1].b)}</td>`;
      body.appendChild(tr);
    }
  }

  function calc() {
    const bal = +$<HTMLInputElement>('bal').value || 0;
    const rate = +$<HTMLInputElement>('rate').value || 0;
    const pmt = +$<HTMLInputElement>('pmt').value || 0;
    const extraAmt = Math.max(0, +$<HTMLInputElement>('extra').value || 0);
    const err = $('pc-error');

    const base = bal > 0 ? amortize(bal, rate, pmt) : null;
    const extra = bal > 0 ? amortize(bal, rate, pmt + extraAmt) : null;

    if (!base || !extra) {
      const minPay = (bal * rate) / 1200;
      err.textContent = bal <= 0
        ? 'Enter a balance above $0.'
        : `Your monthly payment needs to be more than ${usd.format(minPay)} (the first month's interest) to pay the loan down.`;
      err.hidden = false;
      current = null;
      ['s-date', 's-time', 's-int', 's-total'].forEach((id) => ($(id).textContent = '–'));
      $('s-date-sub').textContent = $('s-total-sub').textContent = '';
      $('pc-tbody').innerHTML = '';
      drawChart();
      return;
    }
    err.hidden = true;
    current = { base, extra };

    $('s-date').textContent = dateAfter(extra.months);
    $('s-date-sub').textContent = `${span(extra.months)} from now`;
    $('s-time').textContent = span(base.months - extra.months);
    $('s-int').textContent = usd.format(base.interest - extra.interest);
    $('s-total').textContent = usd.format(extra.interest);
    $('s-total-sub').textContent = `vs ${usd.format(base.interest)} with no extra`;

    renderTable(extra);
    drawChart();
  }

  const extraInput = $<HTMLInputElement>('extra'), extraRange = $<HTMLInputElement>('extra-range');
  extraRange.addEventListener('input', () => { extraInput.value = extraRange.value; calc(); });
  extraInput.addEventListener('input', () => { extraRange.value = extraInput.value; });
  $('pc-form').addEventListener('input', calc);
  $('pc-form').addEventListener('submit', (e) => e.preventDefault());
  new ResizeObserver(() => drawChart()).observe($('pc-chart'));
  calc();
</script>
