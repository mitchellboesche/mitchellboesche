---
import Base from '../../layouts/Base.astro';
---
<Base title="Payoff calculator">
  <section class="article">
    <h1>Mortgage payoff calculator</h1>
    <label>Balance <input id="bal" type="number" value="250000"></label>
    <label>Rate % <input id="rate" type="number" value="6.5" step="0.01"></label>
    <label>Monthly payment <input id="pmt" type="number" value="1800"></label>
    <label>Extra / month <input id="extra" type="number" value="200"></label>
    <p id="out" class="lede"></p>
  </section>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  function calc() {
    let bal = +$('bal').value, r = +$('rate').value / 1200, months = 0;
    const pay = +$('pmt').value + +$('extra').value;
    while (bal > 0 && months < 1200) { bal = bal * (1 + r) - pay; months++; }
    $('out').textContent = months >= 1200
      ? 'Payment too low to pay it off.'
      : `Paid off in ${Math.floor(months / 12)} yrs ${months % 12} mo.`;
  }
  document.querySelectorAll('input').forEach(i => i.addEventListener('input', calc));
  calc();
</script>